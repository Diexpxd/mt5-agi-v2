# Copia este archivo a ".env" y rellena SOLO lo que necesites. Todo es opcional: sin claves el sistema usa bypass (mock).

# ---------------- MetaTrader 5 (solo cuentas DEMO; una cuenta real detiene el sistema) ----------------
# Si dejas login/password/server vacíos se usa la cuenta que ya tenga abierta el terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta al terminal si tienes varias instalaciones, p. ej. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=
# Horas de diferencia hora-servidor-broker - UTC (p. ej. 3 para GMT+3). Vacío = autocalibrar con mercado abierto.
MT5_UTC_OFFSET_HOURS=
MT5_INIT_TIMEOUT_MS=30000

# ---------------- Universo y ejecución ----------------
SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
TIMEFRAME=M15
# paper = simula fills con precios reales (recomendado al empezar) | demo = envía órdenes a la cuenta DEMO de MT5
EXECUTION_MODE=paper
CYCLE_SECONDS=60

# ---------------- Telegram (opcional) ----------------
# Token de @BotFather. Sin él, el bot funciona por consola (scripts/run_system.py --console).
TELEGRAM_KEY=
# Tu id numérico de Telegram (escribe al bot sin configurar y te lo dirá). Admins = pueden pausar/cerrar.
TELEGRAM_ADMIN_IDS=
# Ids con acceso de solo lectura
TELEGRAM_ALLOWED_IDS=

# ---------------- LLM (opcional) ----------------
# Sin clave el sentimiento se calcula con un léxico financiero local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
